# Envio do formulário de contato.
# Sem RESEND_API_KEY o site continua funcionando: a rota responde 503 e o
# formulário abre a mensagem no programa de e-mail do visitante.

# Chave da conta em https://resend.com (nunca versionar a real)
RESEND_API_KEY=

# Remetente. Precisa ser um endereço de domínio verificado na Resend.
CONTACT_FROM="juneBOX <site@junebox.com.br>"

# Caixa que recebe as mensagens
CONTACT_TO=juny@junebox.com.br
